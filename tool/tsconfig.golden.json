{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": ".build",
    "rootDir": "..",
    "types": [
      "node"
    ]
  },
  "include": [
    "../src/**/*.ts",
    "generate-golden.ts",
    "media-probe.ts",
    "history-probe.ts",
    "e2ee-probe.ts",
    "rate-probe.ts",
    "cover-probe.ts",
    "capture-json.ts",
    "field-report.ts",
    "routing-benchmark.ts",
    "routing-targeted.ts",
    "routing-shadow.ts",
    "routing-evolve.ts",
    "routing-contact-bound.ts"
  ],
  "exclude": [
    "../src/**/*.tsx",
    "../src/__tests__/**",
    "../src/crypto/__tests__/**"
  ]
}
