#!/usr/bin/env bash
# Pre-push gate: run the quick pipeline before anything leaves this machine.
#
# Installed by `make install-hooks`, which sets core.hooksPath to .githooks — that keeps the
# hook in version control instead of in .git/hooks where nobody can review or update it.
# Bypass a single push with `git push --no-verify`.
#
# Tuning, via environment:
#   CI_PREPUSH=off    do not run anything
#   CI_PREPUSH=fast   the default: typecheck, unit tests, dart analyze, dart test
#   CI_PREPUSH=full   every job, including the production build and the CLI matrix
#
# Behaviour on a partial run is deliberate. A machine with no Dart SDK cannot verify the
# authoritative engine, and blocking every push over that would make the repository
# unusable rather than safe — so a partial run warns, records itself, and lets the push
# through. A run that actually *failed* blocks it. The distinction is the whole design:
# never silently claim verification you did not do, but do not punish a missing optional
# toolchain as though it were a broken build.

set -uo pipefail

MODE="${CI_PREPUSH:-fast}"
case "$MODE" in
  off|0|no) exit 0 ;;
  fast|full) ;;
  *) printf 'pre-push: CI_PREPUSH=%s is not one of off|fast|full\n' "$MODE" >&2; exit 1 ;;
esac

ROOT="$(git rev-parse --show-toplevel)"
RUNNER="$ROOT/tool/ci/run-pipeline.sh"

if [ ! -x "$RUNNER" ]; then
  printf 'pre-push: %s is missing or not executable — skipping the gate.\n' "$RUNNER" >&2
  exit 0
fi

ARGS=(--fast --keep-going --allow-missing-dart --label pre-push --quiet)
[ "$MODE" = full ] && ARGS=(--keep-going --allow-missing-dart --label pre-push-full --quiet)

printf '\n\033[36m==>\033[0m \033[1mpre-push gate (%s pipeline)\033[0m\n' "$MODE"
printf '    set CI_PREPUSH=off to skip, or push with --no-verify\n\n'

"$RUNNER" "${ARGS[@]}"
RC=$?

case "$RC" in
  0)
    printf '\n\033[32m==>\033[0m \033[1mpre-push gate passed (%s)\033[0m\n\n' "$MODE"
    exit 0
    ;;
  2)
    printf '\n\033[33m==>\033[0m \033[1mpre-push gate PARTIAL\033[0m — some jobs could not run.\n'
    printf '    The push is allowed, because a missing optional toolchain is not a broken\n'
    printf '    build. It is recorded as partial in artifacts/ci/verification-log.jsonl.\n'
    printf '    Remote CI is the authority on the jobs this machine could not run; if it is\n'
    printf '    unavailable, say so wherever these commits are described.\n\n'
    exit 0
    ;;
  *)
    printf '\n\033[31m==>\033[0m \033[1mpre-push gate FAILED\033[0m — push blocked.\n'
    printf '    Fix the failures above, or bypass once with: git push --no-verify\n'
    printf '    Captured output is in the artifact directory named in the run.\n\n'
    exit 1
    ;;
esac
