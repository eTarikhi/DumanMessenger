# No secrets/API/database credentials are needed by the simulator.
# This file is documentation only; Node staging does not automatically load it.
HOST=127.0.0.1
PORT=4173
# Private embedded preview only; default CSP prevents cross-origin framing.
ALLOW_PREVIEW_EMBED=0
# Dev server only, never production: broad host access must be explicit.
ALLOW_ANY_DEV_HOST=0
