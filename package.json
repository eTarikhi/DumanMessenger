{
  "name": "duman-mesh-simulator",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "media": "tsc -p tool/tsconfig.golden.json && node -e \"require('fs').writeFileSync('tool/.build/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node tool/.build/tool/media-probe.js",
    "golden": "tsc -p tool/tsconfig.golden.json && node -e \"require('fs').writeFileSync('tool/.build/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node tool/.build/tool/generate-golden.js",
    "history": "tsc -p tool/tsconfig.golden.json && node -e \"require('fs').writeFileSync('tool/.build/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node tool/.build/tool/history-probe.js",
    "e2ee": "tsc -p tool/tsconfig.golden.json && node -e \"require('fs').writeFileSync('tool/.build/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node tool/.build/tool/e2ee-probe.js",
    "rate": "tsc -p tool/tsconfig.golden.json && node -e \"require('fs').writeFileSync('tool/.build/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node tool/.build/tool/rate-probe.js",
    "cover": "tsc -p tool/tsconfig.golden.json && node -e \"require('fs').writeFileSync('tool/.build/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node tool/.build/tool/cover-probe.js",
    "field:capture": "tsc -p tool/tsconfig.golden.json && node -e \"require('fs').writeFileSync('tool/.build/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node tool/.build/tool/capture-json.js",
    "field:report": "tsc -p tool/tsconfig.golden.json && node -e \"require('fs').writeFileSync('tool/.build/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node tool/.build/tool/field-report.js",
    "routing:benchmark": "tsc -p tool/tsconfig.golden.json && node -e \"require('fs').writeFileSync('tool/.build/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node tool/.build/tool/routing-benchmark.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
